# Copy to .env and fill in. Never commit .env.
# DeepSeek 官方 key（没有也能跑：默认走离线语料模式）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 强制离线语料模式（即使有 key）：1 开 / 0 关
LITPILOT_MOCK=0

# 一轮取几篇、只看近几年
LITPILOT_PAPER_LIMIT=5
LITPILOT_RECENT_YEARS=5

# 每次抽取送给模型的字符预算 / 抽取失败重试次数
LITPILOT_EXTRACT_CHARS=14000
LITPILOT_MAX_EXTRACT_RETRY=2

# 网络超时（秒）
LITPILOT_HTTP_TIMEOUT=30
LITPILOT_FETCH_TIMEOUT=25
LITPILOT_LLM_TIMEOUT=90
